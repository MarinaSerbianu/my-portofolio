{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "postbuild": "node scripts/check-content.mjs",
    "build:preview": "PORTFOLIO_SHOW_DEMO=true PORTFOLIO_SHOW_UNVERIFIED=true next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "check:content": "node scripts/check-content.mjs",
    "test:e2e": "playwright test",
    "qa": "npm run typecheck && npm run lint && npm run build:preview && npm run check:content && playwright test"
  },
  "dependencies": {
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
